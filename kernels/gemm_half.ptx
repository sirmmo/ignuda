//
// Hand-written half-precision GEMM for the ignuda cuBLAS shim.
//
// Unlike kernels/gemm.ptx (generated by NVIDIA's compiler from gemm.cu), this
// kernel is written by hand: the dev image has no nvcc, so the FP16 path that
// cublasGemmEx needs cannot be regenerated from CUDA C here. It is a plain,
// un-unrolled GEMM — correctness first, exactly like the rest of this shim —
// and is covered by a numeric end-to-end test on the OpenCL CPU runtime.
//
// op(A) is MxK, op(B) is KxN, C is MxN, all column-major with leading dims.
// transA/transB: 0 = N (as stored), 1 = T (transpose). A and B are FP16.
// alpha/beta are FP32 (compute type 32F). C is FP16 when cIsF32 == 0, else
// FP32 — covering ggml's CUDA_R_16F / CUDA_R_32F output cases.
//
.version 8.4
.target sm_52
.address_size 64

.visible .entry hgemm(
	.param .u32 hgemm_param_0,   // transA
	.param .u32 hgemm_param_1,   // transB
	.param .u32 hgemm_param_2,   // M
	.param .u32 hgemm_param_3,   // N
	.param .u32 hgemm_param_4,   // K
	.param .f32 hgemm_param_5,   // alpha
	.param .u64 hgemm_param_6,   // A (fp16)
	.param .u32 hgemm_param_7,   // lda
	.param .u64 hgemm_param_8,   // B (fp16)
	.param .u32 hgemm_param_9,   // ldb
	.param .f32 hgemm_param_10,  // beta
	.param .u64 hgemm_param_11,  // C (fp16 or fp32)
	.param .u32 hgemm_param_12,  // ldc
	.param .u32 hgemm_param_13   // cIsF32 (0 = C is fp16, 1 = C is fp32)
)
{
	.reg .pred 	%p<12>;
	.reg .b16 	%h<4>;
	.reg .f32 	%f<20>;
	.reg .b32 	%r<40>;
	.reg .b64 	%rd<40>;

	ld.param.u32 	%r1,  [hgemm_param_0];
	ld.param.u32 	%r2,  [hgemm_param_1];
	ld.param.u32 	%r3,  [hgemm_param_2];
	ld.param.u32 	%r4,  [hgemm_param_3];
	ld.param.u32 	%r5,  [hgemm_param_4];
	ld.param.f32 	%f1,  [hgemm_param_5];
	ld.param.u64 	%rd1, [hgemm_param_6];
	ld.param.u32 	%r6,  [hgemm_param_7];
	ld.param.u64 	%rd2, [hgemm_param_8];
	ld.param.u32 	%r7,  [hgemm_param_9];
	ld.param.f32 	%f2,  [hgemm_param_10];
	ld.param.u64 	%rd3, [hgemm_param_11];
	ld.param.u32 	%r8,  [hgemm_param_12];
	ld.param.u32 	%r9,  [hgemm_param_13];

	cvta.to.global.u64 	%rd1, %rd1;
	cvta.to.global.u64 	%rd2, %rd2;
	cvta.to.global.u64 	%rd3, %rd3;

	// row = blockIdx.x * blockDim.x + threadIdx.x
	mov.u32 	%r10, %ntid.x;
	mov.u32 	%r11, %ctaid.x;
	mov.u32 	%r12, %tid.x;
	mad.lo.s32 	%r13, %r11, %r10, %r12;
	// col = blockIdx.y * blockDim.y + threadIdx.y
	mov.u32 	%r14, %ntid.y;
	mov.u32 	%r15, %ctaid.y;
	mov.u32 	%r16, %tid.y;
	mad.lo.s32 	%r17, %r15, %r14, %r16;

	setp.ge.s32 	%p1, %r13, %r3;
	setp.ge.s32 	%p2, %r17, %r4;
	or.pred  	%p3, %p1, %p2;
	@%p3 bra 	$L_DONE;

	mov.f32 	%f3, 0f00000000;   // acc
	mov.u32 	%r18, 0;           // k
	setp.ge.s32 	%p4, %r18, %r5;
	@%p4 bra 	$L_EPI;

$L_LOOP:
	// a index: transA ? row*lda + k : k*lda + row
	setp.eq.s32 	%p5, %r1, 0;
	@%p5 bra 	$L_A_N;
	mad.lo.s32 	%r20, %r13, %r6, %r18;
	bra.uni 	$L_A_DONE;
$L_A_N:
	mad.lo.s32 	%r20, %r18, %r6, %r13;
$L_A_DONE:
	mul.wide.s32 	%rd10, %r20, 2;
	add.s64 	%rd11, %rd1, %rd10;
	ld.global.b16 	%h1, [%rd11];
	cvt.f32.f16 	%f4, %h1;

	// b index: transB ? k*ldb + col : col*ldb + k
	setp.eq.s32 	%p6, %r2, 0;
	@%p6 bra 	$L_B_N;
	mad.lo.s32 	%r21, %r18, %r7, %r17;
	bra.uni 	$L_B_DONE;
$L_B_N:
	mad.lo.s32 	%r21, %r17, %r7, %r18;
$L_B_DONE:
	mul.wide.s32 	%rd12, %r21, 2;
	add.s64 	%rd13, %rd2, %rd12;
	ld.global.b16 	%h2, [%rd13];
	cvt.f32.f16 	%f5, %h2;

	fma.rn.f32 	%f3, %f4, %f5, %f3;

	add.s32 	%r18, %r18, 1;
	setp.lt.s32 	%p7, %r18, %r5;
	@%p7 bra 	$L_LOOP;

$L_EPI:
	// idx = col*ldc + row
	mad.lo.s32 	%r22, %r17, %r8, %r13;
	mul.f32 	%f10, %f3, %f1;    // alpha * acc

	setp.eq.f32 	%p8, %f2, 0f00000000;   // beta == 0
	setp.eq.s32 	%p9, %r9, 0;           // C is fp16 when cIsF32 == 0
	@%p9 bra 	$L_C_HALF;

	// C is fp32
	mul.wide.s32 	%rd20, %r22, 4;
	add.s64 	%rd21, %rd3, %rd20;
	mov.f32 	%f11, 0f00000000;
	@%p8 bra 	$L_CF_STORE;
	ld.global.f32 	%f12, [%rd21];
	mul.f32 	%f11, %f12, %f2;
$L_CF_STORE:
	add.f32 	%f13, %f10, %f11;
	st.global.f32 	[%rd21], %f13;
	bra.uni 	$L_DONE;

$L_C_HALF:
	mul.wide.s32 	%rd22, %r22, 2;
	add.s64 	%rd23, %rd3, %rd22;
	mov.f32 	%f15, 0f00000000;
	@%p8 bra 	$L_CH_STORE;
	ld.global.b16 	%h3, [%rd23];
	cvt.f32.f16 	%f16, %h3;
	mul.f32 	%f15, %f16, %f2;
$L_CH_STORE:
	add.f32 	%f17, %f10, %f15;
	cvt.rn.f16.f32 	%h3, %f17;
	st.global.b16 	[%rd23], %h3;

$L_DONE:
	ret;
}
